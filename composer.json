{
  "name": "byjg/jwt-wrapper",
  "description": "A simple and flexible wrapper around the Firebase JWT library that makes JWT token handling easy and intuitive in PHP applications",
  "autoload": {
    "psr-4": {
      "ByJG\\JwtWrapper\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Test\\": "tests/"
    }
  },
  "require": {
    "php": ">=8.3 <8.7",
    "firebase/php-jwt": "^7",
    "ext-openssl": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.5"
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "psalm": [
      "@composer --working-dir=tools/psalm update --no-interaction",
      "tools/psalm/vendor/bin/psalm --threads=1"
    ]
  },
  "license": "MIT",
  "prefer-stable": true,
  "minimum-stability": "dev"
}
